NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
NEXT_PUBLIC_APP_URL=https://your-current-vercel-domain.vercel.app
NEXT_PUBLIC_BOT_USERNAME=your_bot_username_without_at

# Required for Telegram auth verification, bot startup, and notifications.
BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=optional_long_random_secret

# Optional Telegram news channel gate.
NEWS_CHANNEL_USERNAME=your_channel_username_without_at
NEWS_CHANNEL_ID=

# Required for trusted server routes. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Required for the httpOnly app session cookie.
JWT_SECRET=replace_with_a_long_random_secret

# Optional: max Telegram auth age in seconds. Default: 86400.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Comma-separated DB user ids that always have owner permissions.
OWNER_USER_IDS=
